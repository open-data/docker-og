
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Watch CKAN Python files",
      "type": "shell",
      "command": "${workspaceFolder}/.scripts/watch-ckan-python.sh",
      "isBackground": true,
      "problemMatcher": {
        "owner": "ckan-watcher",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Watching:",
          "endsPattern": "^READY$"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
